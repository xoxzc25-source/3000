-- МЕГА ЛАЗЕР (режим 2): заряд → залп → растворяет всё на пути, возврат через 50 сек
--------------------------------------------------------------------
local function dissolvePart(part, intensity)
        if not part or not part:IsA("BasePart") or part:IsA("Terrain") then
                return
        end
        if isCharacterPart(part) or activeDissolves[part] then
                return
        end

        -- v6: регистрируем возврат на исходное место ДО растворения
        scheduleRestore(part, "dissolve")
        activeDissolves[part] = true
        -- замораживаем деталь на месте, пока она растворена
        part.Anchored = true

        local vol = part.Size.X * part.Size.Y * part.Size.Z
        local side = vol ^ (1 / 3)

        -- эффект растворения: вспышка искр + свет + исчезновение
        local em = Instance.new("ParticleEmitter")
        em.Color = ColorSequence.new(THEME.on, Color3.new(1, 1, 1))
        em.LightEmission = 1
        em.Lifetime = NumberRange.new(0.4, 1.1)
        em.Rate = 0
        em.Speed = NumberRange.new(2, 10)
        em.SpreadAngle = Vector2.new(180, 180)
        em.Drag = 2
        em.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, math.clamp(side * 0.12, 0.12, 1.4)),
                NumberSequenceKeypoint.new(1, 0),
        })
        em.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.1),
                NumberSequenceKeypoint.new(1, 1),
        })
        em.Parent = part
        local emit = math.clamp(math.floor(vol * 1.5), 40, 260)
        if intensity then
                emit = math.clamp(math.floor(emit * intensity), 10, emit)
        end
        em:Emit(emit)
        Debris:AddItem(em, 2)

        local light = Instance.new("PointLight")
        light.Color = THEME.on
        light.Brightness = 8
        light.Range = math.clamp(side * 2, 8, 40)
        light.Shadows = false
        light.Parent = part
        fxtween(light, 0.5, { Brightness = 0 })
        Debris:AddItem(light, 0.8)

        fxtween(part, 0.4, { Transparency = 1 }, Quad, EIn)
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false

        -- v6: возврат через CONFIG.RestoreTime из общей очереди восстановления:
        -- деталь телепортируется ровно на исходное место и плавно проявляется
end

-- ударная волна раскидывает незакреплённые детали вокруг точки попадания
local function knockParts(a, pos, radius)
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { a.char, a.model }
        local parts = workspace:GetPartBoundsInRadius(pos, radius or CONFIG.KnockRadius, params)
        local count = 0
        for _, p in ipairs(parts) do
                if count >= 40 then
                        break
                end
                if not p.Anchored and not isCharacterPart(p) and not activeDissolves[p]
                        and p:GetMass() < 1200 and p.Transparency < 0.95 then
                        local d = p.Position - pos
                        if d.Magnitude > 0.05 then
                                scheduleRestore(p, "fling") -- v6: раскидаанная деталь вернётся на место
                                local power = math.clamp(60 / d.Magnitude, 10, 52)
                                p.AssemblyLinearVelocity = d.Unit * power + Vector3.new(0, power * 0.4, 0)
                                p.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 14
                                count += 1
                        end
                end
        end
end

