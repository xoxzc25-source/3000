local function cancelTweens()
        for t in pairs(activeTweens) do
                t:Cancel()
        end
        table.clear(activeTweens)
end

-- твин анимации руки: учитывает скорость из меню, отменяется при переключении
local function tween(inst, time, props, style, dir)
        local t = TweenService:Create(inst, TweenInfo.new(time / SETTINGS.speed, style or Quad, dir or EOut), props)
        activeTweens[t] = true
        t.Completed:Once(function()
                activeTweens[t] = nil
        end)
        t:Play()
        return t
end

-- твин интерфейса: не отменяется и не зависит от скорости
local function uiTween(inst, time, props, style, dir)
        local t = TweenService:Create(inst, TweenInfo.new(time, style or Quad, dir or EOut), props)
        t:Play()
        return t
end

local function pause(sec)
        task.wait(sec / SETTINGS.speed)
end

local function waitFor(t)
        if t and t.PlaybackState ~= Enum.PlaybackState.Completed then
                t.Completed:Wait()
        end
end

