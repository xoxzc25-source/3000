                aiming = a.isOpen and a.pose.Value > 0.9 and SETTINGS.crosshair
        end
        ui.tick(dt)
        ui.crosshair(aiming, dt)
        applyShake(dt)

        -- (v10) вид от первого лица: Roblox каждый кадр прячет персонажа через
        -- LocalTransparencyModifier — перебиваем обратно уже после обновления камеры
        if SETTINGS.fpView then
                if player.Character ~= fpChar then
                        rebuildFpParts()
                end
                for _, pp in ipairs(fpParts) do
