local function setFireMode(i)
        i = ((i - 1) % #MODES) + 1
        if SETTINGS.mode == i then
                return
        end
        SETTINGS.mode = i
        playSfx(SFX.LockClick, 0.45, 1.55)
        if i ~= 3 and cutReset then
                cutReset() -- сменили режим посреди реза — линию сбрасываем
        end
        if ui.setMode then
                ui.setMode(i)
        end
        pcall(function()
                ContextActionService:SetTitle(CONFIG.FireAction, MODES[i].btn)
        end)
        local a = arm
        if a and a.ready and a.isOpen then
                -- короткий «чик» смены режима
                pulse(a, 4.5, 1.6)
                burst(a.tips[1], 10)
                for _, e in ipairs(a.glows) do
                        flashOn(e)
                end
                shake(0.12)
        end
end

local function cycleMode()
        setFireMode(SETTINGS.mode + 1)
end

local function onModeAction(_, inputState)
        if inputState == Enum.UserInputState.Begin then
                task.spawn(cycleMode)
        end
        return Enum.ContextActionResult.Sink
end

