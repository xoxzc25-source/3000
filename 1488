local startFling -- (v9) форвард: заполнится в секции ФЛИНГ ниже

local function plasmaFire(a)
        if a.firing then
                return
        end
        a.firing = true
        task.delay(CONFIG.FireCooldown * 0.9, function()
                a.firing = false
        end)

        a.shot += 1
        local idx = (a.shot % #a.tipParts) + 1
        local tip = a.tipParts[idx]
        local target = a.aimPoint or (tip.Position + a.hrp.CFrame.LookVector * 100)

        -- (v9) флинг при попадании по персонажу: поднимаемся от детали до модели
        local flingNode = a.aimHit
        local rootPos = a.hrp and a.hrp.Position
        while flingNode and flingNode ~= workspace do
                if flingNode:IsA("Model") and flingNode:FindFirstChildOfClass("Humanoid") then
                        local tp = flingNode:FindFirstChild("HumanoidRootPart")
                                or flingNode:FindFirstChildWhichIsA("BasePart")
                        if tp and rootPos and (tp.Position - rootPos).Magnitude <= CONFIG.FlingRange then
                                startFling(flingNode, true)
                        end
                        break
                end
                flingNode = flingNode.Parent
        end

        -- трассер
        local tAtt = Instance.new("Attachment")
        tAtt.Parent = workspace.Terrain
        tAtt.WorldPosition = target

        local b = Instance.new("Beam")
        b.Attachment0 = a.muzzles[idx]
        b.Attachment1 = tAtt
        b.FaceCamera = true
        b.LightEmission = 1
        b.Segments = 1
        b.Color = ColorSequence.new(Color3.new(1, 1, 1), THEME.on)
        b.Width0 = 0.7 * a.scale
        b.Width1 = 0.35 * a.scale
        b.Parent = tip
        TweenService:Create(b, TweenInfo.new(0.16), { Width0 = 0, Width1 = 0 }):Play()
        Debris:AddItem(b, 0.3)
        playSfx(SFX.Plasma, 0.45, 0.95 + math.random() * 0.15)

        -- вспышка в точке попадания
        local hitSparks = makeSparkEmitter(tAtt, a.scale)
        burst(hitSparks, 12)
        Debris:AddItem(tAtt, 0.9)

        -- вспышка на дуле, свет, отдача корпуса, лёгкая тряска
        burst(a.tips[idx], 8)
        pulse(a, 5, 1.6)
        shake(0.12)

        local j = a.joints.Body
        local recoil = j.open * CFrame.new(0, 0, 0.28 * a.scale)
        local t = tween(j.motor, 0.05, { C0 = recoil }, Quad, EOut)
        t.Completed:Once(function(state)
                if state == Enum.PlaybackState.Completed and a.model.Parent then
                        tween(j.motor, 0.18, { C0 = j.open }, Quad, EOut)
                end
        end)
end

--------------------------------------------------------------------
-- ВОССТАНОВЛЕНИЕ (v6): всё снесённое возвращается на свои места
--------------------------------------------------------------------
local restoreQueue = {}
local restoreIndex = {}

local function saveSnap(p)
        return {
                cf = p.CFrame,
                t = p.Transparency,
                cc = p.CanCollide,
                ct = p.CanTouch,
                cq = p.CanQuery,
                an = p.Anchored,
        }
end

-- kind: "dissolve" (растворена лазером) / "fling" (раскидаана/оторвана) / "cut" (разрезана)
local function scheduleRestore(part, kind, extra)
        if not part or not part.Parent or not part:IsA("BasePart") then
                return
        end
        local e = restoreIndex[part]
        if e then
                -- уже ждёт возврата: продлеваем таймер и усиливаем тип
                e.at = os.clock() + CONFIG.RestoreTime
                if extra then
                        for k, v in pairs(extra) do
                                e[k] = v
                        end
                end
                if kind == "cut" then
                        e.kind = "cut"
                elseif kind == "dissolve" and e.kind == "fling" then
                        e.kind = "dissolve"
                end
                return
        end
        e = {
                part = part,
                kind = kind,
                at = os.clock() + CONFIG.RestoreTime,
                snap = saveSnap(part),
        }
        if extra then
                for k, v in pairs(extra) do
                        e[k] = v
                end
        end
        restoreIndex[part] = e
        table.insert(restoreQueue, e)
end

-- искры и вспышка при возврате детали
local function restoreBurst(part, side)
        local em = Instance.new("ParticleEmitter")
        em.Color = ColorSequence.new(Color3.new(1, 1, 1), THEME.on)
        em.LightEmission = 1
        em.Lifetime = NumberRange.new(0.3, 0.8)
        em.Rate = 0
        em.Speed = NumberRange.new(1, 6)
        em.SpreadAngle = Vector2.new(180, 180)
        em.Drag = 2
        em.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, math.clamp(side * 0.1, 0.1, 1.1)),
                NumberSequenceKeypoint.new(1, 0),
        })
        em.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.15),
                NumberSequenceKeypoint.new(1, 1),
        })
        em.Parent = part
        em:Emit(math.clamp(math.floor(side * side * 2), 15, 110))
        Debris:AddItem(em, 1.5)

        local light = Instance.new("PointLight")
        light.Color = THEME.on
        light.Brightness = 6
        light.Range = math.clamp(side * 1.6, 6, 28)
        light.Shadows = false
        light.Parent = part
        fxtween(light, 0.45, { Brightness = 0 })
        Debris:AddItem(light, 0.7)
end

-- само возвращение: телепорт на исходное место + проявление
local function runRestore(e)
        local part = e.part
        restoreIndex[part] = nil
        -- (v13) снимаем «иммунитет»: раньше activeDissolves[part] оставался
        -- навсегда, и вернувшаяся деталь больше никогда не сносилась мегой,
        -- не резалась и не раскидывалась — со временем мега «умирала»
        activeDissolves[part] = nil
        -- половинки реза убираем (если ещё живы)
        if e.halves then
                for _, h in ipairs(e.halves) do
                        if h and h.Parent then
                                fxtween(h, 0.25, { Transparency = 1 }, Quad, EIn)
                                Debris:AddItem(h, 0.35)
                        end
                end
        end
        if not (part and part.Parent) then
                return
        end
        local s = e.snap
        local side = (part.Size.X * part.Size.Y * part.Size.Z) ^ (1 / 3)
        -- телепорт ровно на исходное место
        part.Anchored = true
        part.CFrame = s.cf
        part.AssemblyLinearVelocity = Vector3.new()
        part.AssemblyAngularVelocity = Vector3.new()
        -- свойства как до уничтожения
        part.CanCollide = s.cc
        part.CanQuery = s.cq
        part.CanTouch = s.ct
        part.Anchored = s.an
        -- плавное проявление, если деталь была растворена
        if part.Transparency > s.t + 0.05 then
                fxtween(part, 0.45, { Transparency = s.t }, Quad, EOut)
        else
                part.Transparency = s.t
        end
        restoreBurst(part, side)
end

-- общий цикл возврата
RunService.Heartbeat:Connect(function()
        if #restoreQueue == 0 then
                return
        end
        local now = os.clock()
        local keep, n = {}, 0
        for i = 1, #restoreQueue do
                local e = restoreQueue[i]
                if now >= e.at then
                        runRestore(e)
                else
                        n += 1
                        keep[n] = e
                end
        end
        restoreQueue = keep
end)

