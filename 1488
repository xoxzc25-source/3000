-- ПРИЦЕЛИВАНИЕ (каждый кадр, после камеры)
-- Плечо поворачиваем через C0 сустава: рука целится в точку под курсором.
-- Анимацию плеча (Transform) обнуляем в PreSimulation/PostSimulation, чтобы рука не болталась.
--------------------------------------------------------------------
local function updateAim(a, dt)
        local hum = a.humanoid

        -- поворот корпуса по камере (как shift lock): AutoRotate выключаем только пока оружие раскрыто
        local wantFace = SETTINGS.face and a.isOpen
        if wantFace then
                if a.savedAutoRotate == nil then
                        a.savedAutoRotate = hum.AutoRotate
                end
                hum.AutoRotate = false
        elseif a.savedAutoRotate ~= nil then
                hum.AutoRotate = a.savedAutoRotate
                a.savedAutoRotate = nil
        end

        -- (v14) корпус следует за камерой СРАЗУ, до проверок торса и позы:
        -- раньше слежение стояло после ранних return, и если они срабатывали,
        -- AutoRotate уже был выключен, а корпус не поворачивался — персонаж
        -- «застывал» лицом в одну точку (особенно заметно на R15)
        if wantFace and not hum.Sit then
                local cam0 = workspace.CurrentCamera
                if cam0 then
                        local lv = cam0.CFrame.LookVector
                        local flat = Vector3.new(lv.X, 0, lv.Z)
                        if flat.Magnitude > 0.05 then
                                local hrp = a.hrp
                                local goal = CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit)
                                hrp.CFrame = hrp.CFrame:Lerp(goal, 1 - math.exp(-dt * 14))
                        end
                end
        end

        local torso = a.torso
        if not torso.Parent or not a.shoulder.Parent then
                return
        end

        local pose = a.pose.Value
        if pose < 0.001 then
                a.shoulder.C0 = a.shoulderBase
                a.laser.Enabled = false
                a.aimHit = nil
                return
        end

        local cam = workspace.CurrentCamera
        local tcf = torso.CFrame
        local pivotWorld = tcf:PointToWorldSpace(a.pivot)

        -- точка прицеливания: луч из камеры через курсор (на телефоне — центр экрана)
        local point
        if SETTINGS.aim then
                local vp
                if UserInputService.MouseEnabled then
                        vp = UserInputService:GetMouseLocation()
                else
                        vp = cam.ViewportSize / 2
                end
                local ray = cam:ViewportPointToRay(vp.X, vp.Y)
                local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, a.rayParams)
                point = hit and hit.Position or (ray.Origin + ray.Direction * 600)
                a.aimHit = hit and hit.Instance or nil
                if (point - pivotWorld).Magnitude < 6 then
                        point = pivotWorld + ray.Direction * 100
                end
        else
                point = pivotWorld + tcf.LookVector * 100
                a.aimHit = nil
        end
        a.aimPoint = point

        -- направление в системе торса, с ограничением наклона и «не назад»
        local dir = tcf:PointToObjectSpace(point) - a.pivot
        dir = dir.Magnitude > 1e-3 and dir.Unit or Vector3.new(0, 0, -1)
        if dir.Z > -0.15 then
                dir = Vector3.new(dir.X, dir.Y, -0.15).Unit
        end
        local upv = tcf:VectorToObjectSpace(Vector3.yAxis)
        local dy = dir:Dot(upv)
        if math.abs(dy) > 0.95 then
                local hor = dir - upv * dy
                hor = hor.Magnitude > 1e-3 and hor.Unit or Vector3.new(0, 0, -1)
                local ny = dy > 0 and 0.95 or -0.95
                dir = hor * math.sqrt(1 - ny * ny) + upv * ny
        end

        -- ось руки (-Y) -> на цель; «перед» руки (-Z) -> вверх
        local look = CFrame.lookAt(a.pivot, a.pivot + dir, upv)
        local aimC0 = CFrame.new(a.pivot) * (look.Rotation * CFrame.Angles(math.pi / 2, 0, 0)) * a.c1rot
        a.shoulder.C0 = a.shoulderBase:Lerp(aimC0, pose)

        -- (v14) слежение корпуса перенесено в начало updateAim (до проверок)

        -- живое оружие: пульс ядра и искры с кончиков стволов
        if a.ready and a.isOpen then
                a.idleT = (a.idleT or 0) + dt
                local s = 0.5 + 0.5 * math.sin(a.idleT * 2.6)
                if a.core and a.core.Parent then
                        a.core.Color = THEME.on:Lerp(Color3.new(1, 1, 1), 0.15 + 0.4 * s)
                end
                if a.idleT - (a.lastSparkT or 0) > 1.4 then
                        a.lastSparkT = a.idleT
                        burst(a.tips[math.random(1, #a.tips)], 2)
                end
        end
        -- лазерный целеуказатель
        local laserOn = a.ready and a.isOpen and SETTINGS.laser
        a.laser.Enabled = laserOn
        if laserOn then
                local tipPos = a.tipParts[1].Position
                local v = point - tipPos
                if v.Magnitude > 1e-3 then
                        a.aimAtt.WorldPosition = tipPos + v.Unit * math.min(v.Magnitude, 150)
                end
        end
end

local function holdShoulder()
        local a = arm
        if a and a.pose.Value > 0.001 and a.shoulder.Parent then
                a.shoulder.Transform = CFrame.new()
                -- (v14) R15: гасим анимацию поясницы, иначе UpperTorso качается
                -- (idle/бег) и вся пушка «плавает» вокруг курсора — на R6 торс
                -- жёсткий сам по себе, поэтому там такой проблемы не было
                local w = a.waist
                if w and w.Parent then
                        w.Transform = CFrame.new()
                end
        end
end

