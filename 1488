local function axisVal(v, axis)
        if axis == 1 then
                return v.X
        elseif axis == 2 then
                return v.Y
        else
                return v.Z
        end
end

local function withAxisSize(size, axis, value)
        if axis == 1 then
                return Vector3.new(value, size.Y, size.Z)
        elseif axis == 2 then
                return Vector3.new(size.X, value, size.Z)
        else
                return Vector3.new(size.X, size.Y, value)
        end
end

