local fpChar = nil
local fpParts = {}
local function rebuildFpParts()
        table.clear(fpParts)
        fpChar = player.Character
        if not fpChar then
                return
        end
        for _, pp in ipairs(fpChar:GetChildren()) do
                if pp:IsA("BasePart") then
                        local n = pp.Name
                        -- (v11) прячем голову и торс: торс перекрывает обзор от 1 лица;
                        -- ноги и руки остаются видимыми
                        if n ~= "Head" and n ~= "Torso" and n ~= "UpperTorso" and n ~= "LowerTorso" then
                                table.insert(fpParts, pp)
                        end
                end
        end
end

RunService:BindToRenderStep("RickRoboArmAim", Enum.RenderPriority.Camera.Value + 1, function(dt)
        local a = arm
        local aiming = false
        if a and a.model.Parent then
