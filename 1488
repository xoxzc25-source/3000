                Debris:AddItem(inner, 1.35)
                Debris:AddItem(cAtt, 1.5)
                cAtt.WorldPosition = origin + dir * CONFIG.MegaRange
                burst(a.tips[1], 60)
                pulse(a, 10, 1.8)
                stopSfx(chargeSnd)
                playSfx(SFX.Plasma, 1.3, 0.5)
                playSfx(SFX.Piston, 1, 0.6)
                shake(2.4)
                fovPunch(12, 0.06, 0.5)

                local j = a.joints.Body
                local recoil = j.open * CFrame.new(0, 0, 0.9 * a.scale)
                fxtween(j.motor, 0.06, { C0 = recoil }, Quad, EOut)
                task.delay(0.09, function()
                        if a.model.Parent then
                                fxtween(j.motor, 0.35, { C0 = j.open }, Quad, EOut)
                        end
                end)

                -- ПОЛОСА СНОСА: волна идёт от дула и растворяет ВСЁ на пути луча
                local op = OverlapParams.new()
                op.FilterType = Enum.RaycastFilterType.Exclude
                op.FilterDescendantsInstances = { a.char, a.model }
                op.MaxParts = 40
                local total = 0
                local steps = math.ceil(CONFIG.MegaRange / CONFIG.MegaWaveStep)
                for i = 0, steps do
                        if not (a.model and a.model.Parent and arm == a and a.isOpen) then
                                break
                        end
                        local d = i == 0 and 4 or math.min(i * CONFIG.MegaWaveStep, CONFIG.MegaRange)
                        local p = origin + dir * d
                        local found = workspace:GetPartBoundsInRadius(p, CONFIG.MegaWidth, op)
                        local did = 0
                        for _, part in ipairs(found) do
                                if total >= 320 or did >= 24 then
                                        break
                                end
                                if not activeDissolves[part] and not isCharacterPart(part)
                                        and part.Transparency < 0.95 then
                                        local v = part.Size.X * part.Size.Y * part.Size.Z
                                        if v <= CONFIG.MegaMaxVolume then
                                                dissolvePart(part, 0.45)
                                                total += 1
                                                did += 1
                                        end
                                end
                        end
                        knockParts(a, p)
                        if i % 2 == 0 then
                                spawnShockwave(p, dir, (5 + math.random() * 2) * a.scale, i % 4 == 0 and Color3.new(1, 1, 1) or THEME.on)
                        end
                        if i % 4 == 1 then
