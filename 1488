local shakePower = 0

local function shake(power)
        shakePower = math.max(shakePower, power)
end

-- вызывается каждый кадр в главном цикле: двигает камеру и затухает
local function applyShake(dt)
        if shakePower <= 0.001 then
                return
        end
        local cam = workspace.CurrentCamera
        if cam then
                local m = shakePower * 0.045
                cam.CFrame = cam.CFrame
                        * CFrame.Angles((math.random() - 0.5) * m, (math.random() - 0.5) * m, (math.random() - 0.5) * m * 0.6)
        end
        shakePower = math.max(0, shakePower - dt * (1.6 + shakePower * 3.4))
end

local function fovPunch(delta, upTime, backTime)
        local cam = workspace.CurrentCamera
        if not cam then
                return
        end
        local base = cam.FieldOfView
        local t = TweenService:Create(cam, TweenInfo.new(upTime or 0.05, Quad, EOut), { FieldOfView = base + delta })
        t:Play()
        t.Completed:Once(function(state)
                if state == Enum.PlaybackState.Completed and cam.Parent then
                        TweenService:Create(cam, TweenInfo.new(backTime or 0.28, Quad, EOut), { FieldOfView = base }):Play()
                end
        end)
end

