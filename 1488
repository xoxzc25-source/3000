cutReset = function()
        cut.part = nil
        table.clear(cut.points)
        cut.faceAxis = 1
        cut.progress = 0
        cut.lastDot = nil
        if cut.beam then
                cut.beam:Destroy()
                cut.beam = nil
        end
        if cut.att then
                cut.att:Destroy()
                cut.att = nil
        end
        stopSfx(cut.snd)
        cut.snd = nil
end

-- (v12) мягкий сброс: деталь под лучом сменилась — забываем старую линию реза,
-- но НЕ трогаем луч/спарк/звук. Полный cutReset здесь ломал cutTick: он
-- обнулял cut.beam, а код в этом же кадре писал cut.beam.Color -> «attempt
-- to index nil with 'Color'» (30 ошибок в консоли + смерть цикла огня).
cutSoftReset = function()
        cut.part = nil
        table.clear(cut.points)
        cut.faceAxis = 1
        cut.progress = 0
        cut.lastDot = nil
