--------------------------------------------------------------------
local function ensureArm()
        local char = player.Character
        if not char or not char.Parent then
                return nil
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
                return nil
        end

        if arm and arm.model.Parent == char then
                return arm
        end
        if building then
                return nil
        end

        building = true
        if arm then
                destroyArm()
        end
        local ok, result = pcall(function()
                local rig = detectRig(char)
                if not rig then
                        return nil
                end
                return buildArm(char, rig)
        end)
        building = false

        if not ok then
                warn("[RickRoboArm] ошибка сборки: " .. tostring(result))
                return nil
        end
        arm = result
        if arm then
                ui.setRig(arm.rigName)
        end
        return arm
end

local function toggle()
        local a = ensureArm()
        if not a then
                return
        end

        transitionId += 1
        local id = transitionId
        cancelTweens() -- повторное нажатие посреди анимации плавно разворачивает её
        unbindFire()

        a.isOpen = not a.isOpen
        a.ready = false
        ui.setStatus("busy", a.isOpen)

        if a.isOpen then
                task.spawn(runOpen, a, id)
        else
                task.spawn(runClose, a, id)
        end
end

local function onToggleAction(_, inputState)
        if inputState == Enum.UserInputState.Begin then
                task.spawn(toggle)
        end
        return Enum.ContextActionResult.Sink
end

