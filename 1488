-- разрез одной детали плоскостью: n — нормаль плоскости (мир), p0 — точка на плоскости
-- quiet — без искр (когда режем сразу много деталей за раз)
local function slicePart(a, part, n, p0, quiet)
        if not part or not part.Parent then
                return false
        end
        if isCharacterPart(part) or activeDissolves[part] or part.Transparency >= 0.95 then
                return false
        end

        -- (v13) свойство Shape есть только у Part: у UnionOperation/MeshPart/
        -- WedgePart его нет — чтение part.Shape роняло весь рез ошибкой
        -- «Shape is not a valid member of UnionOperation». Считаем их не-блоками.
        local shape = part:IsA("Part") and part.Shape or nil
        if shape ~= Enum.PartType.Block then
                -- не блок — просто отрываем с физикой
                scheduleRestore(part, "fling") -- v6: вернётся на место
                part.Anchored = false
                local away = part.Position - a.hrp.Position
                away = away.Magnitude > 0.5 and away.Unit or Vector3.new(0, 1, 0)
                part.AssemblyLinearVelocity = away * 14 + Vector3.new(0, 8, 0)
                part.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 10
                spawnPieceBurst(part.Position, a.scale)
                return true
        end

        -- локальная ось детали, ближе всех к нормали плоскости
        local ln = part.CFrame:VectorToObjectSpace(n)
        local sepAxis, best = 1, math.abs(ln.X)
        if math.abs(ln.Y) > best then
                sepAxis, best = 2, math.abs(ln.Y)
        end
        if math.abs(ln.Z) > best then
                sepAxis, best = 3, math.abs(ln.Z)
        end
        local axisWorld = part.CFrame:VectorToWorldSpace(AXIS_VEC[sepAxis])
        local denom = axisWorld:Dot(n)
        if math.abs(denom) < 0.2 then
                return false
        end

        -- где плоскость пересекает эту ось (в координатах детали)
        local cutCoord = (p0 - part.Position):Dot(n) / denom
        local size = part.Size
        local half = axisVal(size, sepAxis) / 2
        if math.abs(cutCoord) > half - 0.05 then
                return false -- плоскость не задевает деталь
        end
        local c = math.clamp(cutCoord, -half + 0.15, half - 0.15)
        local sizeA = c + half
        local sizeB = axisVal(size, sepAxis) - sizeA
        if sizeA < 0.15 or sizeB < 0.15 then
                -- слишком тонкий кусок — отрываем деталь целиком, чтобы эффект был всегда
                scheduleRestore(part, "fling") -- v6: вернётся на место
                part.Anchored = false
                local away = part.Position - a.hrp.Position
                away = away.Magnitude > 0.5 and away.Unit or Vector3.new(0, 1, 0)
                part.AssemblyLinearVelocity = away * 10 + Vector3.new(0, 6, 0)
                part.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 8
                spawnPieceBurst(part.Position, a.scale)
                return true
        end

        local halves = {} -- v6: помним половинки, чтобы убрать их при возврате
        for _, info in ipairs({
                { sizeA, -half + sizeA / 2, -1 },
                { sizeB, half - sizeB / 2, 1 },
        }) do
                local piece = Instance.new("Part")
                piece.Name = "RickCutPiece"
                piece.Size = withAxisSize(size, sepAxis, info[1])
                piece.CFrame = part.CFrame * CFrame.new(AXIS_VEC[sepAxis] * info[2])
                piece.Material = part.Material
                piece.Color = part.Color
                piece.Reflectance = part.Reflectance
                piece.Transparency = part.Transparency
                piece.Anchored = false
                piece.CanCollide = true
                piece.TopSurface = Enum.SurfaceType.Smooth
                piece.BottomSurface = Enum.SurfaceType.Smooth
                piece.Parent = ensureFx()
                pcall(function()
                        piece.CollisionGroup = part.CollisionGroup
                end)
                -- половинки расходятся от плоскости реза и падают с физикой
                piece.AssemblyLinearVelocity = axisWorld * info[3] * (3.5 + math.random() * 3)
                        + Vector3.new((math.random() - 0.5) * 2.5, 1.5 + math.random() * 2, (math.random() - 0.5) * 2.5)
                piece.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 7
                task.delay(CONFIG.PiecesLifetime - 1.5, function()
                        if piece.Parent then
                                fxtween(piece, 1.4, { Transparency = 1 }, Quad, EIn)
                        end
                end)
                Debris:AddItem(piece, CONFIG.PiecesLifetime)
                table.insert(halves, piece) -- v6
        end

        if not quiet then
                spawnPieceBurst(part.CFrame:PointToWorldSpace(AXIS_VEC[sepAxis] * c), a.scale)
        end
        -- v6: оригинал не удаляем — прячем и ставим в очередь возврата.
        -- Через RestoreTime секунд половинки исчезнут, а целая деталь
        -- вернётся ровно на своё место.
        scheduleRestore(part, "cut", { halves = halves })
        part.Transparency = 1
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.Anchored = true
        return true
end

local function cutFinish(a)
        local part = cut.part
        local sepAxis, cutCoord = cut.sepAxis, cut.cutCoord
        local pts = {}
        for _, p in ipairs(cut.points) do
                table.insert(pts, p)
        end
        cutReset()
        if not (part and part.Parent) then
                return
        end

        -- плоскость реза в мировых координатах
        local n = part.CFrame:VectorToWorldSpace(AXIS_VEC[sepAxis])
        local p0 = (part.CFrame * CFrame.new(AXIS_VEC[sepAxis] * cutCoord)).Position

        -- цели: сама деталь + (если она внутри модели) детали модели рядом с линией
        local targets = { part }
        local model = part:FindFirstAncestorOfClass("Model")
        if model and model ~= workspace and model ~= a.char then
                local lcp = #pts > 0 and pts[1] or part.Position
                for _, o in ipairs(model:GetDescendants()) do
                        if #targets >= CONFIG.CutMaxTargets then
                                break
                        end
                        if o:IsA("BasePart") and o ~= part and o.Parent and not isCharacterPart(o) and not activeDissolves[o]
                                and o.Transparency < 0.95 and (o.Position - lcp).Magnitude <= 130 then
                                table.insert(targets, o)
                        end
                end
        end

        -- раскалённая кромка ровно по прочерченной линии
        if #pts >= 2 then
                local p1, p2 = pts[1], pts[#pts]
                if (p2 - p1).Magnitude > 0.5 then
                        local edge = Instance.new("Part")
                        edge.Name = "RickCutEdge"
                        edge.Size = Vector3.new(0.16, 0.16, math.clamp((p2 - p1).Magnitude, 1, 90))
                        edge.CFrame = CFrame.lookAt((p1 + p2) / 2, p2)
                        edge.Anchored = true
                        edge.CanCollide = false
                        edge.CanQuery = false
                        edge.CanTouch = false
                        edge.Material = Enum.Material.Neon
                        edge.Color = Color3.new(1, 1, 1)
                        edge.Parent = ensureFx()
                        fxtween(edge, 0.9, { Color = THEME.on, Transparency = 1 }, Quad, EOut)
                        Debris:AddItem(edge, 1.1)
                end
        end

        -- режем каждую деталь, которую плоскость реально пересекает
        local done = 0
        for _, o in ipairs(targets) do
                if o.Parent and not activeDissolves[o] and o.Transparency < 0.95 then
                        local lo = o.CFrame:VectorToObjectSpace(n)
                        local halfN = math.abs(lo.X) * o.Size.X / 2 + math.abs(lo.Y) * o.Size.Y / 2 + math.abs(lo.Z) * o.Size.Z / 2
                        local off = math.abs((o.Position - p0):Dot(n))
                        if off <= halfN + 0.2 then
                                if slicePart(a, o, n, p0, done % 3 ~= 0) then
                                        done += 1
                                end
                        end
                end
        end

        if done > 0 then
                playSfx(SFX.Piston, 0.9, 0.75)
                playSfx(SFX.Latch, 0.5, 1.15)
                spawnPieceBurst(p0, a.scale * 1.2)
                shake(1.1)
                pulse(a, 7, 1.6)
                fovPunch(4, 0.04, 0.25)
        end
end

-- отпустил кнопку: дорезать, если линия достаточно длинная
cutRelease = function()
        local a = arm
        if not (a and a.ready and a.isOpen and SETTINGS.mode == 3) then
                cutReset()
                return
        end
        if cut.part and #cut.points >= 3 and cut.progress >= CONFIG.CutMinProgress then
                cutFinish(a)
        else
                cutReset()
        end
end

local function cutTick(a)
        local muzzle = a.tipParts[1]
        local origin = muzzle.Position
        local target = a.aimPoint or (origin + a.hrp.CFrame.LookVector * 120)
        local dir = target - origin
        if dir.Magnitude < 0.5 then
                return
        end
        dir = dir.Unit

        local ray = workspace:Raycast(origin, dir * CONFIG.MegaRange, a.fxRay)
        local hitPart, hitPos, hitNormal
        if ray then
                hitPart, hitPos, hitNormal = ray.Instance, ray.Position, ray.Normal
        else
                hitPos = origin + dir * 200
        end
        if hitPart and activeDissolves[hitPart] then
                hitPart = nil -- сквозь растворённое луч проходит свободно
        end

        -- луч резака: тонкая «нить», ширина дрожит от нагрузки
        if not cut.att then
                cut.att = Instance.new("Attachment")
                cut.att.Parent = workspace.Terrain
        end
        cut.att.WorldPosition = hitPos
        if not cut.beam then
                cut.beam = Instance.new("Beam")
                cut.beam.Attachment0 = a.muzzles[1]
                cut.beam.Attachment1 = cut.att
                cut.beam.FaceCamera = true
                cut.beam.LightEmission = 1
                cut.beam.Segments = 1
                cut.beam.Transparency = NumberSequence.new(0.1)
                cut.beam.Parent = muzzle
                cut.snd = playSfx(SFX.Hiss, 0.5, 1.15, true)
        end
        local w = 0.085 * a.scale * (1 + 0.2 * math.sin(os.clock() * 22))
        cut.beam.Width0, cut.beam.Width1 = w, w * 0.8

        if not hitPart or isCharacterPart(hitPart) then
                cut.beam.Color = ColorSequence.new(Color3.new(1, 1, 1))
                return
        end

        if cut.part ~= hitPart then
                cutSoftReset() -- (v12) был полный cutReset — он убивал cut.beam
                cut.part = hitPart
                cut.faceAxis = faceAxisFromNormal(hitPart.CFrame, hitNormal)
        end
        if not cut.beam then
                return -- (v12) страховка: луча нет — тихо ждём следующий кадр
        end

        local pts = cut.points
        local lastP = pts[#pts]
        if not lastP or (lastP - hitPos).Magnitude > 0.1 then
                if #pts < 500 then
                        table.insert(pts, hitPos)
                end
        end

        if #pts < 3 then
                cut.beam.Color = ColorSequence.new(THEME.on, Color3.new(1, 1, 1))
                return
        end

        local lineAxis, sepAxis, cutCoord, lineCenter, lineLen, progress = cutStats(hitPart, pts, cut.faceAxis)
        cut.lineAxis, cut.sepAxis = lineAxis, sepAxis
        cut.cutCoord, cut.lineCenter, cut.lineLen = cutCoord, lineCenter, lineLen
        cut.progress = progress

        -- луч гудит и дрожит: лёгкая тряска, растущая с глубиной реза
        shake(0.05 + progress * 0.12)

        -- чем ближе к концу реза, тем горячее луч: тема → белый → оранжевый
        local col = THEME.on:Lerp(Color3.new(1, 1, 1), math.clamp(progress * 1.3, 0, 1))
        if progress > 0.6 then
                col = col:Lerp(Color3.fromRGB(255, 140, 30), (progress - 0.6) * 2.2)
        end
        cut.beam.Color = ColorSequence.new(Color3.new(1, 1, 1), col)

        -- светящиеся метки вдоль линии реза
        if not cut.lastDot or (cut.lastDot - hitPos).Magnitude > CONFIG.CutDotEvery then
                cut.lastDot = hitPos
                spawnCutDot(hitPos, col, a.scale)
        end

        -- искры из точки реза
        ensureCutSpark()
        if os.clock() - cut.lastSparkT > 0.06 then
                cut.lastSparkT = os.clock()
                cut.sparkPart.CFrame = CFrame.new(hitPos)
                if cut.sparkEm then
                        cut.sparkEm:Emit(3)
                end
        end

        -- линия прорезана до конца — стена падает сама
        if progress >= CONFIG.CutAutoAt then
                cutFinish(a)
        end
end

bindFireImpl = function()
        ContextActionService:BindActionAtPriority(CONFIG.FireAction, function(_, state)
                if state == Enum.UserInputState.Begin then
                        if not fireHeld then
                                fireHeld = true
                                task.spawn(function()
                                        while fireHeld and arm and arm.ready do
                                                if SETTINGS.mode == 1 then
                                                        plasmaFire(arm)
                                                        task.wait(CONFIG.FireCooldown)
                                                elseif SETTINGS.mode == 2 then
                                                        megaFire(arm)
                                                        task.wait(0.1)
                                                else
                                                        cutTick(arm)
                                                        task.wait()
                                                end
                                        end
                                        cutRelease()
                                end)
                        end
                elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
                        fireHeld = false
                end
                return Enum.ContextActionResult.Sink
        end, true, Enum.ContextActionPriority.High.Value, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
        ContextActionService:SetTitle(CONFIG.FireAction, MODES[SETTINGS.mode].btn)
end

