                        end
                        shake(0.4)
                        task.wait(CONFIG.MegaWaveDelay)
                end
                spawnShockwave(origin + dir * CONFIG.MegaRange, dir, 14 * a.scale, THEME.on)
                spawnShockwave(origin + dir * 0.6, dir, 4.5 * a.scale, Color3.new(1, 1, 1))

                task.wait(CONFIG.MegaCooldown)
                a.megaBusy = false
        end)
end

