local function applyTheme(index)
        local c = THEMES[index].color
        THEME.index, THEME.on, THEME.off = index, c, dim(c)

        local a = arm
        if a then
                for _, e in ipairs(a.themed) do
                        e.on, e.off = THEME.on, THEME.off
                        uiTween(e.part, 0.25, { Color = e.lit and e.on or e.off })
                end
                a.energy.Color = ColorSequence.new(THEME.on)
                a.laser.Color = ColorSequence.new(THEME.on)
                a.light.Color = THEME.on
                for _, em in ipairs(a.emitters) do
                        em.Color = ColorSequence.new(THEME.on, C.OrangeOn)
                end
        end
        ui.theme()
end

