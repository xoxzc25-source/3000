local function spawnShockwave(pos, normal, diameter, color)
        local n = normal
        if n.Magnitude < 1e-3 then
                n = Vector3.new(0, 1, 0)
        end
        local ring = Instance.new("Part")
        ring.Name = "RickShockwave"
        ring.Shape = Enum.PartType.Cylinder
        ring.Size = Vector3.new(0.06, diameter * 0.3, diameter * 0.3)
        ring.CFrame = CFrame.lookAt(pos, pos + n.Unit) * CFrame.Angles(0, math.pi / 2, 0)
        ring.Anchored = true
        ring.CanCollide = false
        ring.CanQuery = false
        ring.CanTouch = false
        ring.Material = Enum.Material.Neon
        ring.Color = color
        ring.Transparency = 0.15
        ring.Parent = ensureFx()
        fxtween(ring, 0.38, { Size = Vector3.new(0.06, diameter, diameter), Transparency = 1 }, Quad, EOut)
        Debris:AddItem(ring, 0.55)
end

