-- ОПРЕДЕЛЕНИЕ РИГА (R6 / R15)
-- mount   — настоящая часть руки, к которой крепится киберпредплечье
-- rootPos — «запястье» (конец руки) в системе координат mount
-- sleeveLen — длина киберпредплечья в studs
-- real    — настоящие части, которые прячем при превращении
--------------------------------------------------------------------
local function detectRig(char)
        local humanoid = char:WaitForChild("Humanoid", 10)
        local hrp = char:WaitForChild("HumanoidRootPart", 10)
        if not humanoid or not hrp then
                return nil
        end

        if humanoid.RigType == Enum.HumanoidRigType.R15 then
                local torso = char:WaitForChild("UpperTorso", 10)
                local lowerTorso = char:WaitForChild("LowerTorso", 10) -- (v14) для Waist
                local upper = char:WaitForChild("RightUpperArm", 10)
                local lower = char:WaitForChild("RightLowerArm", 10)
                local hand = char:WaitForChild("RightHand", 10)
                if not (torso and upper and lower and hand) then
                        return nil
                end
                local shoulder = upper:WaitForChild("RightShoulder", 10)
                if not shoulder then
                        return nil
                end
                local elbow = lower:FindFirstChild("RightElbow")
                local wrist = hand:FindFirstChild("RightWrist")

                local rootPos, elbowY
                if elbow and wrist then
                        local handCF = elbow.C0 * elbow.C1:Inverse() * wrist.C0 * wrist.C1:Inverse()
                        rootPos = Vector3.new(handCF.X, handCF.Y - hand.Size.Y / 2 - 0.05, handCF.Z)
                        elbowY = elbow.C0.Y
                else
                        elbowY = -upper.Size.Y / 2 + 0.15
                        rootPos = Vector3.new(0, elbowY - lower.Size.Y - hand.Size.Y, 0)
                end

                return {
                        name = "R15",
                        humanoid = humanoid,
                        hrp = hrp,
                        torso = torso,
                        mount = upper,
                        shoulder = shoulder,
                        waist = lowerTorso and lowerTorso:FindFirstChild("Waist"),
                        real = { lower, hand },
                        rootPos = rootPos,
                        sleeveLen = math.clamp(elbowY - rootPos.Y, 1.0, 3.0),
                        width = upper.Size.X,
                        boxy = false,
                }
        end

        local torso = char:WaitForChild("Torso", 10)
        local rightArm = char:WaitForChild("Right Arm", 10)
        if not (torso and rightArm) then
                return nil
        end
        local shoulder = torso:WaitForChild("Right Shoulder", 10)
        if not shoulder then
                return nil
        end

        return {
                name = "R6",
                humanoid = humanoid,
                hrp = hrp,
                torso = torso,
                mount = rightArm,
                shoulder = shoulder,
                real = {}, -- рука цельная: манжета закрывает кисть
                rootPos = Vector3.new(0, -rightArm.Size.Y / 2 - 0.05, 0),
                sleeveLen = rightArm.Size.Y / 2,
                width = rightArm.Size.X,
                boxy = true,
        }
end

--------------------------------------------------------------------
-- СБОРКА МОДЕЛИ RickRoboArm
-- Система координат оружия: вперёд = -Z, вверх = +Y, вправо = +X.
-- Root стоит на конце руки (запястье); рукав уходит назад (+Z), пушка вперёд (-Z).
-- «u» — единица дизайна: 1u = S studs (подгоняется под толщину руки).
--------------------------------------------------------------------
local function buildArm(char, rig)
        for _, old in ipairs(char:GetChildren()) do
                if old.Name == CONFIG.ModelName then
                        old:Destroy() -- защита от дублей
                end
        end
        if not char.Parent then
                return nil
        end

        local S = CONFIG.SizeFactor * math.clamp(rig.width, 0.7, 1.6)
        local Lu = (rig.sleeveLen + 0.05) / S -- длина рукава в u
        local D = (rig.width * 1.1) / S -- толщина рукава в u (чуть толще настоящей руки)
        local R = D / 2

        local a = {
                rigName = rig.name,
                scale = S,
                char = char,
                humanoid = rig.humanoid,
                hrp = rig.hrp,
                torso = rig.torso,
                mount = rig.mount,
                shoulder = rig.shoulder,
                waist = rig.waist, -- (v14) R15: сустав поясницы, фиксируем при прицеливании
                shoulderBase = rig.shoulder.C0,
                c1rot = rig.shoulder.C1.Rotation,
                pivot = rig.shoulder.C0.Position, -- плечо в системе торса
                real = rig.real,
                origTrans = {},
                joints = {},
                lamps = {},
                glows = {},
                themed = {},
                tips = {},
                tipParts = {},
                muzzles = {},
                emitters = {},
                visible = {},
                beams = {},
                conns = {},
                isOpen = false,
                ready = false,
                shown = false,
                morph = "out", -- "out": видна настоящая рука, "in": видно оружие
                firing = false,
                megaBusy = false,
                shot = 0,
                lightRest = 0,
        }
        for _, p in ipairs(a.real) do
                a.origTrans[p] = p.Transparency
        end

        local model = Instance.new("Model")
        model.Name = CONFIG.ModelName

        local cylParts = {}
        local CYL = CFrame.Angles(0, math.pi / 2, 0) -- кладёт ось цилиндра вдоль Z

        local function CF(x, y, z)
                return CFrame.new(x * S, y * S, z * S)
        end

        ---------------------------------------------------------------- детали
        local function newPart(name, shape, size, color, material)
                local p = Instance.new("Part")
                p.Name = name
                p.Shape = shape
                p.Size = size
                p.Color = color
                p.Material = material
                p.CanCollide = false
                p.CanTouch = false
                p.CanQuery = false
                p.Massless = true
                p.Anchored = false
                p.TopSurface = Enum.SurfaceType.Smooth
                p.BottomSurface = Enum.SurfaceType.Smooth
                p.Parent = model
                return p
        end

        local function block(name, x, y, z, color, material)
                return newPart(name, Enum.PartType.Block, Vector3.new(x, y, z) * S, color, material)
        end

        local function cyl(name, length, diameter, color, material)
                local p = newPart(name, Enum.PartType.Cylinder, Vector3.new(length, diameter, diameter) * S, color, material)
                cylParts[p] = true
                return p
        end

        local function ball(name, d, color, material)
                return newPart(name, Enum.PartType.Ball, Vector3.new(d, d, d) * S, color, material)
        end

        -- трубка вдоль Z: цилиндр на R15, коробка на R6 (рука там квадратная)
        local function tube(name, length, diameter, color, material)
                if rig.boxy then
                        return block(name, diameter, diameter, length, color, material)
                end
                return cyl(name, length, diameter, color, material)
        end

        local function dummy(name) -- невидимая опорная деталь
                local p = block(name, 0.1, 0.1, 0.1, C.DarkSteel, Enum.Material.SmoothPlastic)
                p.Transparency = 1
                return p
        end

        ---------------------------------------------------------------- крепления
        local function fix(parent, child, cf) -- неподвижно (Weld)
                local w = Instance.new("Weld")
                w.Name = "W_" .. child.Name
                w.Part0, w.Part1 = parent, child
                w.C0 = cf or CFrame.new()
                if cylParts[child] then
                        w.C1 = CYL:Inverse()
                end
                w.Parent = child
        end

        local function motor(name, parent, child, closed, open) -- подвижно (Motor6D, двигаем C0)
                local m = Instance.new("Motor6D")
                m.Name = "J_" .. name
                m.Part0, m.Part1 = parent, child
                m.C0 = closed
                if cylParts[child] then
                        m.C1 = CYL:Inverse()
                end
                m.Parent = child
                a.joints[name] = { motor = m, closed = closed, open = open }
        end

        ---------------------------------------------------------------- свет и эффекты
        local function glow(p, kind, list)
                local e = { part = p, kind = kind, lit = false }
                if kind == "cyan" then
                        e.on, e.off = THEME.on, THEME.off
                        table.insert(a.themed, e)
                else
                        e.on, e.off = C.OrangeOn, C.OrangeOff
                end
                p.Color = e.off
                if list then
                        table.insert(list, e)
                end
                return e
        end

        local function attach(part, cf)
                local at = Instance.new("Attachment")
                at.CFrame = cf
                at.Parent = part
                return at
        end

        local function beam(a0, a1, width, color, curve, emission)
                local b = Instance.new("Beam")
                b.Attachment0, b.Attachment1 = a0, a1
                b.Color = ColorSequence.new(color)
                b.Width0, b.Width1 = width * S, width * S
                b.FaceCamera = true
                b.Segments = curve and 16 or 2
                b.CurveSize0 = (curve or 0) * S
                b.CurveSize1 = (curve or 0) * S
                b.LightEmission = emission or 0
                b.Parent = a0.Parent
                return b
        end

        local function sparks(parent)
                local e = makeSparkEmitter(parent, S)
                table.insert(a.emitters, e)
                return e
        end

        --================================================================
        -- ROOT — на конце настоящей руки (запястье), «вперёд» = от локтя к пальцам
        --================================================================
        local root = dummy("Root")
        fix(rig.mount, root, CFrame.new(rig.rootPos) * CFrame.Angles(-math.pi / 2, 0, 0))

        --================================================================
        -- КИБЕРПРЕДПЛЕЧЬЕ (рукав) — неподвижная часть
        --================================================================
        local sleeve = tube("Sleeve", Lu, D, C.Steel, Enum.Material.Metal)
        fix(root, sleeve, CF(0, 0, Lu / 2))

        local midZ = math.max(1.12, Lu * 0.75)
        for i, d in ipairs({ { 0.07, 0.14 }, { midZ, 0.16 }, { Lu - 0.07, 0.14 } }) do
                local ring = tube("Ring" .. i, d[2], D + 0.14, C.DarkSteel, Enum.Material.Metal)
                fix(root, ring, CF(0, 0, d[1]))
        end

        local band = tube("GlowBand", 0.08, D + 0.06, C.DarkSteel, Enum.Material.Neon)
        fix(root, band, CF(0, 0, 0.2))
        a.band = glow(band, "cyan")

        for i = 1, 4 do
                local lamp = block("Lamp" .. i, 0.16, 0.1, 0.12, C.OrangeOff, Enum.Material.Neon)
                fix(root, lamp, CF(0, R - 0.01, 0.38 + (i - 1) * 0.18))
                glow(lamp, "orange", a.lamps)
        end

        for _, sx in ipairs({ 1, -1 }) do
                local bolt = ball("Bolt", 0.18, C.DarkSteel, Enum.Material.Metal)
                fix(root, bolt, CF((R - 0.06) * sx, 0, -0.02))

                local armor = block("SideArmor", 0.1, 0.5, 0.5, C.Plate, Enum.Material.Metal)
                fix(root, armor, CF((R + 0.04) * sx, 0, 0.7))
        end

        --================================================================
        -- 4 ПАНЕЛИ «НОСА» — раздвигаются и поворачиваются на шарнирах
        --================================================================
        local HW, PL, PT = R - 0.06, 0.7, 0.12
        local ANG, OUT = 0.62, 0.26

        local plateDefs = {
                { "PlateTop", Vector3.new(HW * 2 + PT, PT, PL), Vector3.new(0, HW, 0), Vector3.new(0, OUT, 0), CFrame.Angles(ANG, 0, 0) },
                { "PlateBottom", Vector3.new(HW * 2 + PT, PT, PL), Vector3.new(0, -HW, 0), Vector3.new(0, -OUT, 0), CFrame.Angles(-ANG, 0, 0) },
                { "PlateRight", Vector3.new(PT, HW * 2 - PT, PL), Vector3.new(HW, 0, 0), Vector3.new(OUT, 0, 0), CFrame.Angles(0, -ANG, 0) },
                { "PlateLeft", Vector3.new(PT, HW * 2 - PT, PL), Vector3.new(-HW, 0, 0), Vector3.new(-OUT, 0, 0), CFrame.Angles(0, ANG, 0) },
        }

        for _, d in ipairs(plateDefs) do
                local name, size, hinge, out, rot = d[1], d[2], d[3], d[4], d[5]
                local p = block(name, size.X, size.Y, size.Z, C.Plate, Enum.Material.Metal)
                local closed = CF(hinge.X, hinge.Y, hinge.Z) * CF(0, 0, -PL / 2)
                local open = CF(hinge.X + out.X, hinge.Y + out.Y, hinge.Z + out.Z) * rot * CF(0, 0, -PL / 2)
                motor(name, root, p, closed, open)
        end

        --================================================================
        -- ШТОК и КРЫШКА
        --================================================================
        local pistonPivot = dummy("PistonPivot")
        motor("Piston", root, pistonPivot, CF(0, 0, 0.3), CF(0, 0, -0.7))

        local rod = cyl("PistonRod", 1.4, 0.3, C.LightSteel, Enum.Material.Metal)
        fix(pistonPivot, rod, CFrame.new())

        local capW = 2 * R - 0.1
        local ch = capW / 2
        local capZ = -(PL + 0.08 + 0.3)
        local cap = block("Cap", capW, capW, 0.12, C.Steel, Enum.Material.Metal)
        motor(
                "Cap",
                pistonPivot,
                cap,
                CF(0, -ch, capZ) * CF(0, ch, 0),
                CF(0, -ch, capZ) * CFrame.Angles(-math.pi / 2, 0, 0) * CF(0, ch, 0)
        )

        local visor = block("CapVisor", capW * 0.6, 0.22, 0.04, C.DarkSteel, Enum.Material.Metal)
        fix(cap, visor, CF(0, 0.15, -0.08))

        local capEye = block("CapEye", 0.28, 0.28, 0.04, C.DarkSteel, Enum.Material.Neon)
        fix(cap, capEye, CF(0, -0.12, 0.08))
        glow(capEye, "cyan", a.glows)

        local capLamp = block("CapLamp", capW * 0.55, 0.1, 0.04, C.OrangeOff, Enum.Material.Neon)
        fix(cap, capLamp, CF(0, 0.28, 0.08))
        glow(capLamp, "orange", a.glows)

        --================================================================
        -- КОРПУС ПУШКИ — скользит по штоку
        --================================================================
        local BW = 0.85
        local body = block("GunBody", BW, BW, 0.5, C.DarkSteel, Enum.Material.Metal)
        motor("Body", root, body, CF(0, 0, 0.55), CF(0, 0, -1.55))

        local core = ball("Core", 0.34, C.DarkSteel, Enum.Material.Neon)
        fix(body, core, CF(0, BW / 2, 0.05))
        glow(core, "cyan", a.glows)
        a.core = core

        for _, sx in ipairs({ 1, -1 }) do
                local lamp = block("BodyLamp", 0.08, 0.14, 0.22, C.OrangeOff, Enum.Material.Neon)
                fix(body, lamp, CF((BW / 2 + 0.02) * sx, 0, 0.08))
                glow(lamp, "orange", a.glows)
        end

        --================================================================
        -- ДВА ТЕЛЕСКОПИЧЕСКИХ СТВОЛА (золото + белые манжеты)
        --================================================================
        local barrelDefs = {
                -- id, x, y, длина основной трубы, длина выдвижной
                { "A", 0.34, 0.1, 1.0, 0.9 },
                { "B", -0.34, -0.1, 0.75, 0.7 },
        }

        for _, d in ipairs(barrelDefs) do
                local id, bx, by, len, flen = d[1], d[2], d[3], d[4], d[5]

                local bp = dummy("BarrelPivot" .. id)
                fix(body, bp, CF(bx, by, -0.25))

                local rear = cyl("RearTube" .. id, len, 0.3, C.Gold, Enum.Material.Metal)
                fix(bp, rear, CF(0, 0, -len / 2))

                local cuff = cyl("Cuff" .. id, 0.26, 0.4, C.White, Enum.Material.SmoothPlastic)
                fix(bp, cuff, CF(0, 0, -0.2))

                local ring = cyl("GlowRing" .. id, 0.05, 0.35, C.DarkSteel, Enum.Material.Neon)
                fix(bp, ring, CF(0, 0, -0.5))
                glow(ring, "cyan", a.glows)

                local fp = dummy("FrontPivot" .. id)
                motor("Front" .. id, bp, fp, CF(0, 0, -0.05), CF(0, 0, -(len - 0.12)))

                local ft = cyl("FrontTube" .. id, flen, 0.22, C.GoldDark, Enum.Material.Metal)
                fix(fp, ft, CF(0, 0, -flen / 2))

                local tip = cyl("Tip" .. id, 0.07, 0.27, C.DarkSteel, Enum.Material.Neon)
                fix(fp, tip, CF(0, 0, -flen))
                glow(tip, "cyan", a.glows)

                table.insert(a.tipParts, tip)
                table.insert(a.muzzles, attach(tip, CFrame.new()))
                table.insert(a.tips, sparks(tip))
        end

        --================================================================
        -- КАБЕЛИ, ТЯГИ, ЭНЕРГОКАБЕЛЬ, ЛАЗЕР
        --================================================================
        local up = CFrame.Angles(0, 0, math.pi / 2)
        local down = CFrame.Angles(0, 0, -math.pi / 2)

        table.insert(a.beams, beam(attach(root, CF(0.26, R - 0.08, 0.35) * up), attach(body, CF(0.26, BW / 2 - 0.02, 0.15) * up), 0.07, C.Cable, 0.3))
        table.insert(a.beams, beam(attach(root, CF(-0.26, -(R - 0.08), 0.35) * down), attach(body, CF(-0.26, -(BW / 2 - 0.02), 0.15) * down), 0.07, C.Cable, 0.3))

        for _, sx in ipairs({ 1, -1 }) do
                table.insert(a.beams, beam(attach(root, CF((R - 0.06) * sx, 0, -0.02)), attach(body, CF((BW / 2 + 0.02) * sx, 0, 0.1)), 0.11, C.LightSteel, nil))
        end

        a.energy = beam(attach(root, CF(-0.26, R - 0.08, 0.6) * up), attach(body, CF(-0.26, BW / 2 - 0.02, 0.3) * up), 0.1, THEME.on, 0.25, 1)
        a.energy.Width0, a.energy.Width1 = 0.001, 0.001

        a.aimAtt = Instance.new("Attachment")
        a.aimAtt.Name = "RickArmAimPoint"
        a.aimAtt.Parent = workspace.Terrain
        a.laser = beam(a.muzzles[1], a.aimAtt, 0.05, THEME.on, nil, 1)
        a.laser.Transparency = NumberSequence.new(0.35)
        a.laser.Enabled = false

        --================================================================
        -- ИСКРЫ, СВЕТ, ПОЗА
        --================================================================
        a.sparksNose = sparks(root)
        a.sparksArm = sparks(sleeve)
        a.sparksBody = sparks(body)

        local light = Instance.new("PointLight")
        light.Name = "ArmLight"
        light.Color = THEME.on
        light.Range = 12 * S
        light.Brightness = 0
        light.Shadows = false
        light.Parent = body
        a.light = light

        local pose = Instance.new("NumberValue") -- 0 = рука опущена, 1 = целится
        pose.Name = "Pose"
        pose.Parent = model
        a.pose = pose

        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { char }
        a.rayParams = rp

        local fxrp = RaycastParams.new()
        fxrp.FilterType = Enum.RaycastFilterType.Exclude
        fxrp.FilterDescendantsInstances = { char, model }
        a.fxRay = fxrp

        -- до превращения оружие невидимо
        for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") and d.Transparency == 0 then
                        table.insert(a.visible, d)
                        d.Transparency = 1
                end
        end
        for _, b in ipairs(a.beams) do
                b.Enabled = false
        end

        if not char.Parent then
                model:Destroy()
                a.aimAtt:Destroy()
                return nil
        end

        a.model = model
        model.Parent = char

        -- если модель удалили снаружи — сбросить состояние (при следующем нажатии соберётся заново)
        table.insert(
                a.conns,
                model.Destroying:Connect(function()
                        if arm == a then
                                destroyArm()
                        end
                end)
        )

        return a
end

--------------------------------------------------------------------
-- ОЧИСТКА
--------------------------------------------------------------------
local function setRealHidden(a, hidden)
        for _, p in ipairs(a.real) do
                if p.Parent then
                        p.Transparency = hidden and 1 or a.origTrans[p]
                end
        end
end

local function unbindFire()
        fireHeld = false
        ContextActionService:UnbindAction(CONFIG.FireAction)
end

destroyArm = function()
        transitionId += 1
        cancelTweens()
        if cutReset then
                cutReset()
        end
        unbindFire()

        local a = arm
        arm = nil
        if not a then
                return
        end

        for _, c in ipairs(a.conns) do
                c:Disconnect()
        end
        setRealHidden(a, false) -- настоящая рука возвращается
        if a.shoulder.Parent then
                a.shoulder.C0 = a.shoulderBase
        end
        if a.savedAutoRotate ~= nil and a.humanoid.Parent then
                a.humanoid.AutoRotate = a.savedAutoRotate
        end
        if a.aimAtt then
                a.aimAtt:Destroy()
        end
        if a.model then
                a.model:Destroy()
        end
        ui.setStatus("closed", false)
        ui.setRig("—")
        ui.progress(0)
end

--------------------------------------------------------------------
-- ХЕЛПЕРЫ АНИМАЦИИ
--------------------------------------------------------------------
local function moveJoint(a, name, toOpen, time, style, dir)
        local j = a.joints[name]
        return tween(j.motor, time, { C0 = toOpen and j.open or j.closed }, style, dir)
end

local function settled(a, name, toOpen)
        local j = a.joints[name]
        local target = toOpen and j.open or j.closed
        return (j.motor.C0.Position - target.Position).Magnitude < 0.03 * a.scale
end

-- двигает сустав, но пропускает, если он уже на месте (удобно при повторном нажатии)
local function go(a, name, toOpen, time, style, dir)
        if settled(a, name, toOpen) then
                return nil
        end
        return moveJoint(a, name, toOpen, time, style, dir)
end

local function setGlow(e, on, time)
        e.lit = on
        return tween(e.part, time or 0.15, { Color = on and e.on or e.off })
end

local function flashOn(e) -- короткая белая вспышка, потом цвет свечения
        e.lit = true
        local t = tween(e.part, 0.1, { Color = Color3.new(1, 1, 1) })
        t.Completed:Once(function(state)
                if state == Enum.PlaybackState.Completed and e.part.Parent then
                        tween(e.part, 0.35, { Color = e.on })
                end
        end)
end

local function setEnergy(a, on, time)
        local w = on and 0.09 * a.scale or 0.001
        tween(a.energy, time or 0.3, { Width0 = w, Width1 = w })
end

local function pulse(a, peak, rest) -- световой импульс: резко вверх, потом плавно к «покою»
        a.lightRest = rest
        local upTween = tween(a.light, 0.07, { Brightness = peak })
        upTween.Completed:Once(function(state)
                if state == Enum.PlaybackState.Completed and a.light.Parent then
                        tween(a.light, 0.4, { Brightness = a.lightRest })
                end
        end)
end

local function setBeams(a, on)
        for _, b in ipairs(a.beams) do
                b.Enabled = on
        end
end

local function fadeModel(a, show, time)
        a.shown = show
        for _, p in ipairs(a.visible) do
                tween(p, time, { Transparency = show and 0 or 1 }, Quad, EOut)
        end
        if show then
                task.delay(time * 0.6 / SETTINGS.speed, function()
                        if a.model.Parent and a.shown then
                                setBeams(a, true)
                        end
                end)
        else
                setBeams(a, false)
                a.laser.Enabled = false
        end
end

--------------------------------------------------------------------
-- ПРЕВРАЩЕНИЕ: настоящее предплечье -> киберпредплечье (и обратно)
--------------------------------------------------------------------
local function morphIn(a, alive)
        pulse(a, 4, 0)
        burst(a.sparksArm, 26)
        burst(a.sparksNose, 16)
        for i = 1, 3 do -- «глитч» настоящего предплечья и кисти
                setRealHidden(a, true)
                pause(0.045)
                if not alive() then
                        return false
                end
                setRealHidden(a, false)
                pause(0.045)
                if not alive() then
                        return false
                end
                if i == 1 then
                        fadeModel(a, true, 0.3)
                end
                shake(0.12)
        end
        -- стробоскоп: сборку «прошивает» током перед раскрытием
        for _, lamp in ipairs(a.lamps) do
                setGlow(lamp, true, 0.05)
        end
        pause(0.07)
        if not alive() then
                return false
        end
        for _, lamp in ipairs(a.lamps) do
                setGlow(lamp, false, 0.05)
        end
        setRealHidden(a, true)
        a.morph = "in"
        return true
end

local function morphOut(a, alive)
        burst(a.sparksArm, 22)
        pulse(a, 3, 0)
