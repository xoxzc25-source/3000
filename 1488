-- РЕЗАК (режим 3): зажал — ведёшь линию — стена разваливается надвое
--------------------------------------------------------------------
local function faceAxisFromNormal(cf, n)
        local ln = cf:VectorToObjectSpace(n)
        local ax, ay, az = math.abs(ln.X), math.abs(ln.Y), math.abs(ln.Z)
        if ax >= ay and ax >= az then
                return 1
        elseif ay >= az then
                return 2
        else
                return 3
        end
end

-- линия реза = ось с большим разбросом точек; поперёк неё деталь и рвём
local function cutStats(part, points, faceAxis)
        local cf = part.CFrame
        local minv, maxv
        for _, p in ipairs(points) do
                local lp = cf:PointToObjectSpace(p)
                if not minv then
                        minv, maxv = lp, lp
                else
                        minv = Vector3.new(math.min(minv.X, lp.X), math.min(minv.Y, lp.Y), math.min(minv.Z, lp.Z))
                        maxv = Vector3.new(math.max(maxv.X, lp.X), math.max(maxv.Y, lp.Y), math.max(maxv.Z, lp.Z))
                end
        end
        local spread = maxv - minv
        local a1, a2
        if faceAxis == 1 then
                a1, a2 = 2, 3
        elseif faceAxis == 2 then
                a1, a2 = 1, 3
        else
                a1, a2 = 1, 2
        end
        local lineAxis, sepAxis
        if axisVal(spread, a1) >= axisVal(spread, a2) then
                lineAxis, sepAxis = a1, a2
        else
                lineAxis, sepAxis = a2, a1
        end
        local extent = axisVal(part.Size, lineAxis)
        local lineLen = axisVal(spread, lineAxis)
        local need = math.clamp(extent * 0.6, CONFIG.CutNeedMin, CONFIG.CutNeedMax)
        local progress = math.clamp(lineLen / math.max(need, 0.1), 0, 1)
        local cutCoord = (axisVal(minv, sepAxis) + axisVal(maxv, sepAxis)) / 2
        local lineCenter = (axisVal(minv, lineAxis) + axisVal(maxv, lineAxis)) / 2
        return lineAxis, sepAxis, cutCoord, lineCenter, lineLen, progress
end

local function ensureCutSpark()
