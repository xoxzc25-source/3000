local function makeSparkEmitter(parent, scale)
        local e = Instance.new("ParticleEmitter")
        e.Name = "Sparks"
        e.Enabled = false
        e.Rate = 0
        e.Lifetime = NumberRange.new(0.25, 0.55)
        e.Speed = NumberRange.new(8, 18)
        e.SpreadAngle = Vector2.new(180, 180)
        e.Drag = 3
        e.Acceleration = Vector3.new(0, -18, 0)
        e.LightEmission = 1
        e.Color = ColorSequence.new(THEME.on, C.OrangeOn)
        e.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.28 * scale),
                NumberSequenceKeypoint.new(1, 0),
