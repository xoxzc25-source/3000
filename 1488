--------------------------------------------------------------------
-- ФЛИНГ (v8): бросок игрока столкновением тел
-- Свой персонаж каждый кадр телепортируется внутрь цели и получает
-- гигантскую скорость: Roblox доверяет физике владельца персонажа,
-- поэтому цель получает огромный импульс и улетает.
--------------------------------------------------------------------
local flingBusy = false
local flingCancel = false
local flingLastT = -1e9

local function flingCharacter(targetChar, maxTime)
        maxTime = maxTime or CONFIG.FlingMaxTime
        if flingBusy then
                return false
        end

        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local tHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        local tPart = targetChar
                and (targetChar:FindFirstChild("HumanoidRootPart")
                        or targetChar:FindFirstChild("Head")
                        or targetChar:FindFirstChildWhichIsA("BasePart"))
        if not (root and hum and hum.Health > 0 and tHum and tHum.Health > 0 and tPart) then
                return false
        end
        if tHum.Sit then
                return false
        end

        flingBusy, flingCancel = true, false

        -- маркер на цели: подсветка + надпись
        local hl = Instance.new("Highlight")
        hl.FillColor = THEME.on
        hl.OutlineColor = Color3.new(1, 1, 1)
        hl.FillTransparency = 0.7
        hl.Parent = targetChar

        local bb = Instance.new("BillboardGui")
        bb.Name = "RickFlingMark"
        bb.Size = UDim2.fromOffset(140, 30)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        bb.Parent = tPart
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBlack
        lbl.TextSize = 18
        lbl.TextColor3 = THEME.on
        lbl.TextStrokeTransparency = 0.25
        lbl.Text = "FLINGING ↓"
        lbl.Parent = bb

        local savedPivot = char:GetPivot()
        local savedAutoRotate = hum.AutoRotate
        local savedFallen = workspace.FallenPartsDestroyHeight
        local savedSeated = hum:GetStateEnabled(Enum.HumanoidStateType.Seated)

        local bv = Instance.new("BodyVelocity")
        bv.Velocity = Vector3.zero
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Parent = root

        hum.AutoRotate = false
        local fallenDisabled = pcall(function()
                workspace.FallenPartsDestroyHeight = 0 / 0
        end)
        pcall(hum.SetStateEnabled, hum, Enum.HumanoidStateType.Seated, false)

        playSfx(SFX.Servo, 0.8, 1.2)
        playSfx(SFX.Hiss, 0.6, 1.3)

        local started, launchOrigin, launched = os.clock(), tPart.Position, false

        local function escaped()
                if not tPart.Parent then
                        return false
                end
                local d = (tPart.Position - launchOrigin).Magnitude
                local s = tPart.AssemblyLinearVelocity.Magnitude
                return tPart.Position.Y <= savedFallen + 30 or d > 350 or (d > 120 and s > 200)
        end

        local function place(offset, rot)
                local cf = CFrame.new(tPart.Position) * offset * rot
                root.CFrame = cf
                char:PivotTo(cf)
                root.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
                root.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
        end

        local ok = pcall(function()
                local angle = 0
                while os.clock() - started < maxTime and not flingCancel do
                        if not (root.Parent and hum.Health > 0 and tPart.Parent and tHum.Health > 0) then
                                break
                        end
                        if escaped() then
                                launched = true
                                break
                        end
                        local speed = tPart.AssemblyLinearVelocity.Magnitude
                        angle += 100
                        local steps
                        if speed < 50 then
                                local lead = tHum.MoveDirection * speed / 1.25
                                local rot = CFrame.Angles(math.rad(angle), 0, 0)
                                steps = {
                                        { CFrame.new(0, 1.5, 0) + lead, rot },
                                        { CFrame.new(0, -1.5, 0) + lead, rot },
                                        { CFrame.new(0, 1.5, 0) + lead, rot },
                                        { CFrame.new(0, -1.5, 0) + lead, rot },
                                        { CFrame.new(0, 1.5, 0) + tHum.MoveDirection, rot },
                                        { CFrame.new(0, -1.5, 0) + tHum.MoveDirection, rot },
                                }
                        else
                                local flat, quarter = CFrame.new(), CFrame.Angles(math.rad(90), 0, 0)
                                steps = {
                                        { CFrame.new(0, 1.5, tHum.WalkSpeed), quarter },
                                        { CFrame.new(0, -1.5, -tHum.WalkSpeed), flat },
                                        { CFrame.new(0, 1.5, tHum.WalkSpeed), quarter },
                                        { CFrame.new(0, -1.5, 0), quarter },
                                        { CFrame.new(0, -1.5, 0), flat },
                                        { CFrame.new(0, -1.5, 0), quarter },
                                        { CFrame.new(0, -1.5, 0), flat },
                                }
                        end
                        for _, s in ipairs(steps) do
                                place(s[1], s[2])
                                task.wait()
                                if flingCancel or escaped() then
                                        launched = not flingCancel
                                        break
                                end
                        end
                        if launched then
                                break
                        end
                end
        end)

        if launched then
                playSfx(SFX.Piston, 1.1, 0.62)
                playSfx(SFX.Plasma, 0.9, 0.5)
                shake(1.6)
                fovPunch(7, 0.05, 0.4)
        end

        if bv.Parent then
                bv:Destroy()
        end
        pcall(hum.SetStateEnabled, hum, Enum.HumanoidStateType.Seated, savedSeated)
        if root.Parent and hum.Health > 0 then
                pcall(function()
                        for _ = 1, 6 do
                                char:PivotTo(savedPivot * CFrame.new(0, 0.5, 0))
                                for _, p in ipairs(char:GetChildren()) do
                                        if p:IsA("BasePart") then
                                                p.AssemblyLinearVelocity = Vector3.zero
                                                p.AssemblyAngularVelocity = Vector3.zero
                                        end
                                end
                                if (root.Position - savedPivot.Position).Magnitude < 25 then
                                        break
                                end
                                RunService.Heartbeat:Wait()
                        end
                        hum.AutoRotate = savedAutoRotate
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
        end
        if fallenDisabled then
                pcall(function()
                        workspace.FallenPartsDestroyHeight = savedFallen
                end)
        end
        if hl.Parent then
                hl:Destroy()
        end
        if bb.Parent then
                bb:Destroy()
        end
        flingBusy = false
        return ok and launched
end

-- кого флингим: игрок под курсором, иначе ближайший живой перед нами
local function findFlingTarget()
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
                return nil
        end

        local cam = workspace.CurrentCamera
        if cam then
                local vp = UserInputService.MouseEnabled and UserInputService:GetMouseLocation()
                        or cam.ViewportSize / 2
                local ray = cam:ViewportPointToRay(vp.X, vp.Y)
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = { char }
                local hit = workspace:Raycast(ray.Origin, ray.Direction * CONFIG.FlingRange, rp)
                local node = hit and hit.Instance
                while node and node ~= workspace do
                        if node:IsA("Model") and node:FindFirstChildOfClass("Humanoid") then
                                return node
                        end
                        node = node.Parent
                end
        end

        local best, bestD = nil, CONFIG.FlingFallback
        for _, pl in ipairs(Players:GetPlayers()) do
                if pl ~= player then
                        local pc = pl.Character
                        local pr = pc and pc:FindFirstChild("HumanoidRootPart")
                        local ph = pc and pc:FindFirstChildOfClass("Humanoid")
                        if pr and ph and ph.Health > 0 then
                                local off = pr.Position - root.Position
                                local d = off.Magnitude
                                if d < bestD and d > 0.5 and off.Unit:Dot(root.CFrame.LookVector) > 0.3 then
                                        best, bestD = pc, d
                                end
                        end
                end
        end
        return best
end

-- запуск флинга с защитой от спама: клавиша F и попадания плазмы (v9)
function startFling(targetChar, fromShot)
        if flingBusy or os.clock() - flingLastT < CONFIG.FlingCooldown then
                return
        end
        flingLastT = os.clock()
        if fromShot then
                playSfx(SFX.Piston, 0.8, 1.05)
        else
                playSfx(SFX.LockClick, 0.6, 1.4)
        end
        task.spawn(flingCharacter, targetChar, CONFIG.FlingMaxTime)
end

local function tryFling()
        local target = findFlingTarget()
        if target then
                startFling(target)
        else
                playSfx(SFX.LockClick, 0.5, 0.7)
        end
end

